{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/css/(.*)", "destination": "/admin/css/$1" },
    { "source": "/admin/js/(.*)", "destination": "/admin/js/$1" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(about|shop|cart|contact|confirmation)", "destination": "/public/$1.html" },
    { "source": "/(css/.*|js/.*|assets/.*)", "destination": "/public/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
